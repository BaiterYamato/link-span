{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shiplua.dev/schema/manifest.schema.json",
  "title": "ShipLua mod manifest (manifest.toml)",
  "description": "Schema for the manifest.toml every ShipLua mod ships at its root. This is a documentation/validation reference; the runtime parser (ManifestParser) implements the same rules in C++. Unknown/extra keys are ignored by the runtime for forward compatibility.",
  "type": "object",
  "required": ["id", "name", "version", "api", "entrypoint"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Globally unique mod identifier, reverse-DNS style recommended.",
      "examples": ["community.low_gravity"]
    },
    "name": {
      "type": "string",
      "description": "Human-readable display name.",
      "examples": ["Low Gravity"]
    },
    "version": {
      "type": "string",
      "description": "Mod version as a semver string.",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "examples": ["1.2.0"]
    },
    "api": {
      "type": "string",
      "description": "ShipLua API version range this mod is compatible with.",
      "examples": [">=0.1 <1.0"]
    },
    "entrypoint": {
      "type": "string",
      "description": "Lua entrypoint file, relative to the mod directory.",
      "examples": ["main.lua"]
    },
    "description": {
      "type": "string",
      "description": "Optional short description of the mod."
    },
    "authors": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional list of author names/handles."
    },
    "games": {
      "type": "array",
      "items": { "type": "string", "enum": ["oot", "mm"] },
      "uniqueItems": true,
      "description": "Games the mod targets. Omitted or empty means both."
    },
    "requires_both_games": {
      "type": "boolean",
      "default": false,
      "description": "Link-Span-only hard requirement for both OoT and MM assets. When true the launcher refuses to start (exit code 8) unless assets for both games are present. Distinct from games=[\"oot\",\"mm\"], which means 'runs in either host'."
    },
    "kind": {
      "type": "string",
      "enum": ["mod", "core_extension"],
      "default": "mod",
      "description": "Module role. core_extension may publish native services for later mods."
    },
    "load_phase": {
      "type": "string",
      "enum": ["pre_game", "runtime"],
      "default": "runtime",
      "description": "Lifecycle phase. pre_game is reserved for core_extension modules."
    },
    "host": {
      "type": "object",
      "description": "Optional per-host version ranges.",
      "properties": {
        "shipwright": {
          "type": "string",
          "description": "Version range for Ship of Harkinian (OoT).",
          "examples": [">=9.0"]
        },
        "two_ship": {
          "type": "string",
          "description": "Version range for 2Ship2Harkinian (MM).",
          "examples": [">=2.0"]
        }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "object",
      "description": "Host capabilities the mod uses.",
      "properties": {
        "required": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Capabilities that must be present or the mod fails to load."
        },
        "optional": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Capabilities used opportunistically when present."
        }
      },
      "additionalProperties": true
    },
    "resources": {
      "type": "object",
      "description": "Host VFS assets required before the mod can load.",
      "properties": {
        "required": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "description": "Relative VFS paths. Missing paths reject this mod before executing it."
        }
      },
      "additionalProperties": true
    },
    "dependencies": {
      "type": "object",
      "description": "Map of dependency mod id -> version range.",
      "additionalProperties": { "type": "string" },
      "examples": [{ "community.mod_menu": ">=2.0" }]
    },
    "load": {
      "type": "object",
      "description": "Load-order hints. Full ordering resolution is a later milestone.",
      "properties": {
        "priority": {
          "type": "integer",
          "default": 50,
          "description": "Load priority; lower loads earlier. Default 50."
        },
        "after": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Mod ids this mod must load after."
        },
        "before": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Mod ids this mod must load before."
        }
      },
      "additionalProperties": true
    },
    "permissions": {
      "type": "object",
      "description": "Sandbox permissions requested by the mod. Boolean legacy permissions default to false; generic grants must use stable dotted ids.",
      "properties": {
        "storage": { "type": "boolean", "default": false },
        "network": { "type": "boolean", "default": false },
        "clipboard": { "type": "boolean", "default": false },
        "grants": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
          },
          "uniqueItems": true,
          "default": [],
          "description": "Generic capability permissions such as world.entities.create."
        }
      },
      "additionalProperties": true
    },
    "provider": {
      "type": "object",
      "description": "Provider nativo opcional. Exige host com código nativo habilitado e API >=0.5.0. Funções são definidas pelo mod, sem catálogo central.",
      "required": [
        "abi_version"
      ],
      "properties": {
        "abi_version": {
          "enum": ["1.0", "1.1", "1.2", "1.3", "1.4"]
        },
        "host_fingerprints": {
          "type": "array",
          "description": "ABI 1.3 e 1.4, só core_extension: SHA-256 dos executáveis em que símbolos privados e patches do escape hatch podem ser usados.",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        },
        "host_layout_id": {
          "type": "string",
          "description": "ABI 1.4, só core_extension: layout id (SHA-256) do SDK com que o provider foi compilado. Igual ao do host, resolve_symbol atende os nomes do catálogo público sem fingerprint.",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "win64": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*[\\\\:\\u0000])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$).+$"
        },
        "linux64": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*[\\\\:\\u0000])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$).+$"
        },
        "macos": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*[\\\\:\\u0000])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$).+$"
        }
      },
      "anyOf": [
        {
          "required": [
            "win64"
          ]
        },
        {
          "required": [
            "linux64"
          ]
        },
        {
          "required": [
            "macos"
          ]
        }
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "description": "Per-mod resource limits that may only reduce host/provider limits.",
      "properties": {
        "actors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256,
          "default": 16,
          "description": "Maximum live actors owned by this mod. Zero disables actor spawning."
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["kind"],
        "properties": { "kind": { "const": "core_extension" } }
      },
      "then": {
        "required": ["load_phase", "provider"],
        "properties": {
          "load_phase": { "const": "pre_game" },
          "provider": {
            "properties": { "abi_version": { "enum": ["1.1", "1.2", "1.3", "1.4"] } }
          }
        }
      }
    },
    {
      "if": {
        "required": ["load_phase"],
        "properties": { "load_phase": { "const": "pre_game" } }
      },
      "then": {
        "required": ["kind"],
        "properties": { "kind": { "const": "core_extension" } }
      }
    },
    {
      "if": {
        "required": ["provider"],
        "properties": { "provider": { "required": ["host_layout_id"] } }
      },
      "then": {
        "required": ["kind"],
        "properties": {
          "kind": { "const": "core_extension" },
          "provider": { "properties": { "abi_version": { "const": "1.4" } } }
        }
      }
    },
    {
      "if": {
        "required": ["provider"],
        "properties": { "provider": { "required": ["host_fingerprints"] } }
      },
      "then": {
        "required": ["kind"],
        "properties": {
          "kind": { "const": "core_extension" },
          "provider": { "properties": { "abi_version": { "enum": ["1.3", "1.4"] } } }
        }
      }
    }
  ],
  "additionalProperties": true
}
